{
  "name": "samuel-akpabio-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "format": "prettier --write src index.html vite.config.ts tsconfig*.json package.json README.md DESIGN.md",
    "format:check": "prettier --check src index.html vite.config.ts tsconfig*.json package.json README.md DESIGN.md"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "packageManager": "bun@1.4.0"
}
